<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tạo đơn tại bàn</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/orders.css"></head><body><jsp:include page="/WEB-INF/views/fragments/header.jsp"/>
<main class="orders-page"><h1>Tạo đơn hàng tại bàn</h1><c:if test="${not empty orderMessage}"><p class="notice"><c:out value="${orderMessage}"/></p></c:if>
<form action="${pageContext.request.contextPath}/manage-orders" method="post" class="order-form"><input type="hidden" name="csrfToken" value="${sessionScope.orderCsrf}"><input type="hidden" name="action" value="create">
<div class="form-grid"><label>Tên khách<input name="customerName" maxlength="100" required></label><label>Số điện thoại<input name="customerPhone" maxlength="20" required></label><label>Email (tùy chọn)<input type="email" name="customerEmail" maxlength="100"></label>
<label>Bàn<select name="tableId" required><option value="">Chọn bàn</option><c:forEach var="table" items="${tables}"><option value="${table.tableId}"><c:out value="${table.tableName}"/> · <c:out value="${table.status}"/> · <c:out value="${table.capacity}"/> khách</option></c:forEach></select></label>
<label>Reservation đã duyệt (tùy chọn)<input type="number" name="reservationId" min="1"></label><label>Ghi chú<input name="note" maxlength="500"></label></div>
<h2>Chọn món</h2><div class="dish-choice"><c:forEach var="dish" items="${dishes}"><label class="dish-choice-row"><span><c:out value="${dish.dishName}"/> — <c:out value="${dish.price}"/> đ / <c:out value="${dish.unit}"/></span><input type="number" min="0" max="99" name="quantity_${dish.dishId}" value="0" aria-label="Số lượng ${dish.dishName}"></label></c:forEach></div>
<button type="submit">Tạo đơn đang phục vụ</button></form></main></body></html>
