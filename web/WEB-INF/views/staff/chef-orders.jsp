<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="5"><title>Đơn hàng bếp</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/orders.css"></head><body><jsp:include page="/WEB-INF/views/fragments/header.jsp"/>
<main class="orders-page chef-orders"><header class="page-heading"><div><p>KHU VỰC BẾP</p><h1>Đơn hàng cần chế biến</h1></div></header>
<c:choose><c:when test="${empty orders}"><p class="chef-empty">Hiện không có đơn hàng đã xác nhận cần chế biến.</p></c:when><c:otherwise><div class="chef-order-list"><c:forEach var="order" items="${orders}"><article class="chef-order-card">
<header class="chef-order-heading"><div><h2>Đơn hàng #<c:out value="${order.orderId}"/></h2><p>Bàn <c:out value="${empty order.tableName ? 'Chưa gán' : order.tableName}"/></p></div><span class="status"><c:choose><c:when test="${order.status eq 'APPROVED'}">Đã xác nhận</c:when><c:otherwise>Đang phục vụ</c:otherwise></c:choose></span></header>
<p class="chef-order-time">Xác nhận lúc <c:out value="${empty order.approvedAt ? order.createdAt : order.approvedAt}"/></p>
<table><thead><tr><th>Món ăn</th><th>Số lượng</th></tr></thead><tbody><c:forEach var="item" items="${order.items}"><tr><td><c:out value="${item.dishName}"/></td><td><c:out value="${item.quantity}"/> <c:out value="${item.unit}"/></td></tr></c:forEach></tbody></table>
<footer class="chef-order-footer"><p>Trạng thái bếp: <strong><c:choose><c:when test="${order.chefStatus eq 'PREPARING'}">Đang chuẩn bị</c:when><c:otherwise>Chờ chuẩn bị</c:otherwise></c:choose></strong></p></footer>
</article></c:forEach></div></c:otherwise></c:choose></main></body></html>
