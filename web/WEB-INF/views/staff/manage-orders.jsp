<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quản lý đơn hàng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/orders.css"></head><body><jsp:include page="/WEB-INF/views/fragments/header.jsp"/>
<main class="orders-page staff-orders"><header class="page-heading"><div><p>VẬN HÀNH NHÀ HÀNG</p><h1>Quản lý đơn hàng</h1></div><a class="button" href="${pageContext.request.contextPath}/manage-orders?action=new">Tạo đơn tại bàn</a></header>
<c:if test="${not empty orderMessage}"><p class="notice"><c:out value="${orderMessage}"/></p></c:if>
<nav class="status-filter"><a href="${pageContext.request.contextPath}/manage-orders">Tất cả</a><a href="?status=PENDING">Chờ duyệt</a><a href="?status=APPROVED">Đã duyệt</a><a href="?status=OPEN">Đang phục vụ</a><a href="?status=PAID">Đã thanh toán</a><a href="?status=CANCELLED">Đã hủy</a></nav>
<c:choose><c:when test="${empty orders}"><p>Không có đơn hàng.</p></c:when><c:otherwise><div class="order-list"><c:forEach var="order" items="${orders}"><article class="order-card"><div><strong>Đơn #<c:out value="${order.orderId}"/></strong><span class="status"><c:out value="${order.status}"/></span></div><p><c:out value="${order.customerName}"/> · <c:out value="${order.customerPhone}"/></p><p>Bàn: <c:out value="${order.tableName}"/> · <c:out value="${order.createdAt}"/></p><p>Tổng: <c:out value="${order.totalAmount}"/> đ</p><a class="button" href="${pageContext.request.contextPath}/manage-orders?id=${order.orderId}">Chi tiết</a></article></c:forEach></div></c:otherwise></c:choose></main></body></html>
