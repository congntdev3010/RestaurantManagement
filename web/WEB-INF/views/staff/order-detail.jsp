<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ page import="model.User" %><% User actor=(User)session.getAttribute("user"); boolean manager=actor!=null && "Manager".equalsIgnoreCase(actor.getRoleName()); %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chi tiết đơn</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/orders.css"></head><body><jsp:include page="/WEB-INF/views/fragments/header.jsp"/>
<main class="orders-page"><c:if test="${not empty orderMessage}"><p class="notice"><c:out value="${orderMessage}"/></p></c:if><h1>Đơn #<c:out value="${order.orderId}"/></h1>
<div class="order-summary"><p>Trạng thái: <strong><c:out value="${order.status}"/></strong></p><p>Khách: <c:out value="${order.customerName}"/> · <c:out value="${order.customerPhone}"/></p><p>Email: <c:out value="${order.customerEmail}"/></p><p>Bàn: <c:out value="${order.tableName}"/> · Reservation: <c:out value="${order.reservationId}"/></p><p>Tạo lúc <c:out value="${order.createdAt}"/></p><c:if test="${not empty order.cancellationReason}"><p>Lý do hủy: <c:out value="${order.cancellationReason}"/></p></c:if></div>
<table><thead><tr><th>Món</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody><c:forEach var="item" items="${order.items}"><tr><td><c:out value="${item.dishName}"/></td><td><c:out value="${item.unitPrice}"/> đ</td><td><c:out value="${item.quantity}"/></td><td><c:out value="${item.lineTotal}"/> đ</td></tr></c:forEach></tbody></table><p class="total">Tổng cộng: <c:out value="${order.totalAmount}"/> đ</p>
<div class="order-actions">
<c:if test="${order.status eq 'PENDING'}"><form method="post" action="${pageContext.request.contextPath}/manage-orders"><input type="hidden" name="csrfToken" value="${sessionScope.orderCsrf}"><input type="hidden" name="orderId" value="${order.orderId}"><input type="hidden" name="action" value="approve"><button type="submit">Duyệt đơn</button></form><form method="post" action="${pageContext.request.contextPath}/manage-orders"><input type="hidden" name="csrfToken" value="${sessionScope.orderCsrf}"><input type="hidden" name="orderId" value="${order.orderId}"><input type="hidden" name="action" value="cancel"><input name="reason" maxlength="500" placeholder="Lý do hủy" required><button class="danger" type="submit">Hủy đơn</button></form></c:if>
<c:if test="${order.status eq 'APPROVED'}"><form method="post" action="${pageContext.request.contextPath}/manage-orders"><input type="hidden" name="csrfToken" value="${sessionScope.orderCsrf}"><input type="hidden" name="orderId" value="${order.orderId}"><input type="hidden" name="action" value="start"><button type="submit">Bắt đầu phục vụ</button></form><form method="post" action="${pageContext.request.contextPath}/manage-orders"><input type="hidden" name="csrfToken" value="${sessionScope.orderCsrf}"><input type="hidden" name="orderId" value="${order.orderId}"><input type="hidden" name="action" value="cancel"><input name="reason" maxlength="500" placeholder="Lý do hủy" required><button class="danger" type="submit">Hủy đơn</button></form></c:if>
<c:if test="${order.status eq 'OPEN'}"><form method="post" action="${pageContext.request.contextPath}/manage-orders"><input type="hidden" name="csrfToken" value="${sessionScope.orderCsrf}"><input type="hidden" name="orderId" value="${order.orderId}"><input type="hidden" name="action" value="paid"><button type="submit">Đánh dấu đã thanh toán</button></form><form method="post" action="${pageContext.request.contextPath}/manage-orders"><input type="hidden" name="csrfToken" value="${sessionScope.orderCsrf}"><input type="hidden" name="orderId" value="${order.orderId}"><input type="hidden" name="action" value="cancel"><input name="reason" maxlength="500" placeholder="Lý do hủy" required><button class="danger" type="submit">Hủy đơn</button></form></c:if>
</div><c:if test="${order.status eq 'OPEN'}"><form action="${pageContext.request.contextPath}/manage-orders" method="post" class="order-form"><input type="hidden" name="csrfToken" value="${sessionScope.orderCsrf}"><input type="hidden" name="action" value="updateItems"><input type="hidden" name="orderId" value="${order.orderId}"><h2>Cập nhật món</h2><c:forEach var="item" items="${order.items}"><label><c:out value="${item.dishName}"/><input type="number" name="quantity_${item.dishId}" min="0" max="99" value="${item.quantity}"></label></c:forEach><label>Thêm món<select name="newDishId"><option value="">Chọn món</option><c:forEach var="dish" items="${availableDishes}"><option value="${dish.dishId}"><c:out value="${dish.dishName}"/> — <c:out value="${dish.price}"/> đ</option></c:forEach></select></label><label>Số lượng thêm<input type="number" name="newQuantity" min="0" max="99" value="0"></label><button type="submit">Lưu món và tính lại tổng</button></form></c:if><a class="button secondary" href="${pageContext.request.contextPath}/manage-orders">Quay lại danh sách</a></main></body></html>
