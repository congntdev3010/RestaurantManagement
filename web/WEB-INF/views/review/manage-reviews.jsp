<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Duyệt đánh giá</title>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/reviews.css?v=1"></head><body class="review-page review-admin">
<jsp:include page="/WEB-INF/views/fragments/header.jsp"/><main class="review-shell review-management">
<header class="review-admin-head"><p class="review-kicker">QUẢN LÝ NHÀ HÀNG</p><h1>Duyệt đánh giá</h1><p>Đánh giá chỉ xuất hiện công khai sau khi được duyệt.</p><c:if test="${not empty sessionScope.reviewManageMessage}"><div class="review-flash"><c:out value="${sessionScope.reviewManageMessage}"/></div><c:remove var="reviewManageMessage" scope="session"/></c:if></header>
<section class="review-list"><c:choose><c:when test="${empty pendingReviews}"><div class="review-empty">Hiện không có đánh giá nào chờ duyệt.</div></c:when><c:otherwise><c:forEach var="review" items="${pendingReviews}"><article class="review-card"><div class="review-card-top"><div><strong><c:out value="${review.customerName}"/></strong><small>Hóa đơn #<c:out value="${review.historyId}"/> · <c:out value="${review.createdAtText}"/> · Bàn <c:out value="${review.tableName}"/></small></div><span class="stars"><c:forEach begin="1" end="${review.rating}" var="i">★</c:forEach><c:forEach begin="1" end="${5-review.rating}" var="i">☆</c:forEach></span></div><p><c:out value="${review.reviewText}"/></p>
<div class="review-actions"><form method="post" action="${pageContext.request.contextPath}/manage-reviews"><input type="hidden" name="reviewId" value="${review.reviewId}"><button class="review-approve" name="action" value="approve">Duyệt hiển thị</button><button class="review-reject" name="action" value="reject">Từ chối</button></form></div></article></c:forEach></c:otherwise></c:choose></section></main></body></html>
