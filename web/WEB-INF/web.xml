<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <!-- Địa chỉ gốc dự phòng của website dùng trong QR bàn, ví dụ
    https://order.example.com/RestaurantManagement (không có dấu / ở cuối).
    Có thể dùng biến môi trường QR_BASE_URL để cấu hình mà không sửa WAR; biến môi trường được ưu tiên. -->
    <context-param>
        <param-name>qrBaseUrl</param-name>
        <param-value>https://parish-pretzel-upcountry.ngrok-free.dev/RestaurantManagement</param-value>
    </context-param>
    <!-- URL ảnh QR tài khoản nhà hàng dùng khi lễ tân thu tiền chuyển khoản. -->
    <context-param>
        <param-name>paymentQrImageUrl</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>paymentBankCode</param-name>
        <param-value>970423</param-value>
    </context-param>
    <context-param>
        <param-name>paymentAccountNumber</param-name>
        <param-value>88802102004</param-value>
    </context-param>
    <context-param>
        <param-name>paymentAccountName</param-name>
        <param-value>TRUONG KHANH DONG</param-value>
    </context-param>
    <!-- Mọi địa chỉ không tồn tại (404) đều đưa khách về trang chủ thay vì trang lỗi. -->
    <error-page>
        <error-code>404</error-code>
        <location>/error-404</location>
    </error-page>
    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>
</web-app>
