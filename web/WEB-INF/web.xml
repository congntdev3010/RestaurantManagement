<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <!-- Địa chỉ gốc của website dùng trong mã QR bàn, ví dụ http://192.168.1.10:8080/RestaurantManagement
         (không có dấu / ở cuối). Để trống thì lấy theo địa chỉ đang truy cập; khi đó mở trang bằng IP/tên miền
         thật chứ không dùng localhost, nếu không điện thoại của khách không quét vào được. -->
    <context-param>
        <param-name>qrBaseUrl</param-name>
        <param-value></param-value>
    </context-param>
    <!-- Mọi địa chỉ không tồn tại (404) đều đưa khách về trang chủ thay vì trang lỗi. -->
    <error-page>
        <error-code>404</error-code>
        <location>/error-404</location>
    </error-page>
    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>
</web-app>
